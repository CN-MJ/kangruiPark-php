APP_NAME=赣南健康城
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:3922

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# 园区停车位总数
TOTAL_PARKING_SPOTS=100

# 道闸硬件对接
PARKING_HARDWARE_ENABLED=true
PARKING_HARDWARE_API_KEY_HEADER=X-API-Key

# 登录安全
AUTH_PASSWORD_MIN_LENGTH=6
AUTH_REQUIRE_PASSWORD_PARK=true
AUTH_REQUIRE_PASSWORD_MERCHANT=true
# 企业工作台（服务发布 / 预约处理）；访客预约业务需要开启
MERCHANT_WORKBENCH_ENABLED=true
AUTH_REVOKE_PREVIOUS_TOKENS=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=15
AUTH_CAPTCHA_TTL_SECONDS=300

# 微信小程序（访客授权手机号；本地无 Secret 时自动 mock）
WECHAT_MINI_APPID=wx39a8d9793e036455
WECHAT_MINI_SECRET=
WECHAT_MINI_MOCK=false
WECHAT_MINI_MOCK_PHONE=13900000001

# 微信服务号（公众号）网页授权 + 模板消息
WECHAT_MP_APPID=wx74302affcadcb3c6
WECHAT_MP_SECRET=96bf272c12373cc1c3d2e2ebc152b814
# 模板 ID（测试可先填假数据，上线后换成公众平台真实模板）
WECHAT_MP_TPL_TO_MERCHANT=
WECHAT_MP_TPL_TO_VISITOR=
# H5 授权页完整 URL（须与公众平台「网页授权域名」一致，并做 urlEncode 使用）
WECHAT_MP_AUTH_REDIRECT_URI=

# 开发者升权控制台（指定访客号连点版本号后二次验证进入）
SUPER_CONSOLE_ENABLED=true
SUPER_TOKEN_TTL_HOURS=4
# 可选：逗号分隔 IP，限制超管升权与控制台访问；空=不限制
SUPER_ADMIN_IP_ALLOWLIST=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kangruidb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
